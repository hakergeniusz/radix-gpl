[Desktop Entry]
Type=Application
Name=Calculator
GenericName=Calculator
Comment=Perform arithmetic, scientific, financial and programming calculations
# NON_UNIQUE application: each launch is an independent window with its
# own history tape (D9), so both entries simply start `radix`.
Exec=radix
Icon=io.github.hakergeniusz.Radix
Terminal=false
Categories=GNOME;GTK;Utility;Science;Math;
Keywords=calculator;math;arithmetic;scientific;financial;programming;conversion;
StartupNotify=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=radix
