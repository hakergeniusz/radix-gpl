# D-Bus service activation for the Radix search provider (doc 08 §6).
# Install to $prefix/share/dbus-1/services/ with @bindir@ substituted by the
# installation bindir, e.g. Exec=/usr/local/bin/radix-search-provider.
[D-BUS Service]
Name=io.github.hakergeniusz.Radix.SearchProvider
Exec=@bindir@/radix-search-provider
