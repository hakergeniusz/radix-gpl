# AUR-style PKGBUILD for Radix, following the Arch/Rust package
# guidelines. The git tag, Cargo.toml, debian/changelog, the metainfo
# releases and the Fedora spec must be bumped together; on a version
# bump, update sha256sums (updpkgsums) along with pkgver/_tag.
# m4/base-devel covers gmp-mpfr-sys, which builds its bundled
# GMP/MPFR/MPC from source at compile time (statically linked).
# Maintainer: hakergeniusz <hakergeniusz@users.noreply.github.com>

pkgname=radix
_tag=v51.1.3
pkgver=51.1.3
pkgrel=1
pkgdesc="Desktop calculator with scientific, financial and programming modes (GNOME Calculator reimplementation)"
arch=('x86_64')
url="https://github.com/hakergeniusz/radix-gpl"
license=('GPL3')
depends=('gtk4' 'libadwaita')
makedepends=('cargo' 'm4')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
# Re-pin with `updpkgsums` (or the release source archive) right after
# tagging; must be SKIP whenever a tag is cut: the Arch CI job verifies
# the tag's own archive against this file, and a checksum pinned to an
# older tag would fail it.
sha256sums=('ec324a19bcd45aa29ac15b2df335159ac3291b9778967dbcbadb17e104e0d109')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="target"
  # --frozen = --locked --offline: deps are pinned and already fetched.
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="target"
  ./target/release/radix --version
  ./target/release/radix-cmd "2+2" | grep -qx 4
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/radix -t "$pkgdir/usr/bin"
  install -Dm755 target/release/radix-cmd -t "$pkgdir/usr/bin"
  install -Dm755 target/release/radix-search-provider -t "$pkgdir/usr/bin"
  install -Dm644 crates/radix-gui/data/applications/io.github.hakergeniusz.Radix.desktop \
    "$pkgdir/usr/share/applications/io.github.hakergeniusz.Radix.desktop"
  install -d "$pkgdir/usr/share/dbus-1/services"
  sed 's|@bindir@|/usr/bin|' \
    crates/radix-gui/data/dbus-1/services/io.github.hakergeniusz.Radix.SearchProvider.service \
    > "$pkgdir/usr/share/dbus-1/services/io.github.hakergeniusz.Radix.SearchProvider.service"
  install -Dm644 crates/radix-gui/data/metainfo/io.github.hakergeniusz.Radix.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.hakergeniusz.Radix.metainfo.xml"
  install -Dm644 crates/radix-gui/data/icons/hicolor/scalable/apps/io.github.hakergeniusz.Radix.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.hakergeniusz.Radix.svg"
  install -Dm644 crates/radix-gui/data/icons/hicolor/symbolic/apps/io.github.hakergeniusz.Radix-symbolic.svg \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.hakergeniusz.Radix-symbolic.svg"
  # Gettext catalogs (D33): only language dirs (with an LC_MESSAGES
  # subtree) are installed; the .mo files are committed in-tree.
  install -d "$pkgdir/usr/share/locale"
  for l in crates/radix-gui/data/locales/*/; do
    if [ -d "$l/LC_MESSAGES" ]; then
      cp -a "$l" "$pkgdir/usr/share/locale/"
    fi
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/radix/LICENSE"
}
